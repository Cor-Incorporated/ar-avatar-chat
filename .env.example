# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# 第一候補: Google Calendarの「非公開アドレス（iCal形式）」。必ずserver-only envとして設定します。
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# fallback: iCal URL未設定時に使用するサービスアカウント設定
GOOGLE_CALENDAR_CLIENT_EMAIL=calendar-reader@example-project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# 現在の日時・空き時間計算はAsia/Tokyo固定。他の値は設定エラーになります。
GOOGLE_CALENDAR_TIMEZONE=Asia/Tokyo
# [公開]タイトルは匿名公開されます。タイトルへURLや秘密情報を記載しないでください。
GOOGLE_CALENDAR_PUBLIC_PREFIX=[公開]
GOOGLE_CALENDAR_BUSINESS_START=09:00
GOOGLE_CALENDAR_BUSINESS_END=18:00
# VITE_GOOGLE_CALENDAR_ICAL_URLは廃止済みです。private URLをVITE_変数へ設定しないでください。

# Local server
PORT=3000
